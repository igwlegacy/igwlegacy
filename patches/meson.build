# Refresh at build time so a new commit updates incremental builds as well.
git_version = vcs_tag(
	input: 'version.h.in',
	output: 'version.h',
	command: ['git', 'describe', '--tags', '--always'],
	fallback: 'unknown',
)

patch_sources = [git_version] + files(
	'version.c',
	'no_steam.c',
	'disable_bobbing.c',
	'fog.c',
	'maxfps.c',
	'net_defaults.c',
	# 'ambient_sounds.c',
	'screen_shake.c',
	'damage_kick.c',
	'burning_screen.c',
	'landing_dip.c',
	'death_camera.c',
	'respawn_countdown.c',
	'centerprint_position.c',
	'cursor_size.c',
	'cursor_position.c',
	'main_menu_ad.c',
	'main_menu_github.c',
	'main_menu_top_edge.c',
	'loading_background.c',
	'loading_menu.c',
	# 'autoplay.c',
	'valuable_markers.c',
	'stronghold_markers.c',
	'pickup_markers.c',
	'skip_intro.c',
	'bot_slots.c',
	'flood_protect.c',
	'console_stdout.c',
	'console_visibility.c',
	'window_close.c',
	'use_shaders.c',
	'heat_haze.c',
